# Validate the benchmark's machine-readable output against its human-readable
# table, without comparing noisy timings or requiring particular CPU backends.
execute_process(COMMAND "${BENCHMARK}" --min-ms 0 1
  RESULT_VARIABLE status OUTPUT_VARIABLE table ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Table benchmark failed: ${error}")
endif()
string(REPLACE "\n" ";" lines "${table}")
set(table_rows)
foreach(line IN LISTS lines)
  if(line MATCHES "^[vs]_" AND NOT line MATCHES " SIMD unavailable")
    string(LENGTH "${line}" length)
    if(NOT length EQUAL 121)
      message(FATAL_ERROR "Misaligned table row (${length} columns): ${line}")
    endif()
    string(SUBSTRING "${line}" 0 30 instruction)
    string(SUBSTRING "${line}" 31 4 wave)
    string(SUBSTRING "${line}" 36 9 semantics)
    string(SUBSTRING "${line}" 46 20 flags)
    string(SUBSTRING "${line}" 67 14 fp_state)
    string(SUBSTRING "${line}" 82 18 cpu)
    string(SUBSTRING "${line}" 101 10 time)
    string(SUBSTRING "${line}" 112 9 speedup)
    foreach(field instruction wave semantics flags fp_state cpu time speedup)
      string(STRIP "${${field}}" ${field})
    endforeach()
    if(NOT time MATCHES "^[0-9]+\\.[0-9]$" OR
       NOT speedup MATCHES "^([0-9]+\\.[0-9][0-9]x|--)$")
      message(FATAL_ERROR "Invalid numeric table fields: ${line}")
    endif()
    list(APPEND table_rows "${instruction},${wave},${semantics},${flags},${fp_state},${cpu}")
  endif()
endforeach()
if(NOT table_rows)
  message(FATAL_ERROR "No benchmark rows")
endif()

foreach(order csv_first csv_last)
  if(order STREQUAL csv_first)
    set(arguments --csv --min-ms 0 1)
  else()
    set(arguments 1 --min-ms 0 --csv)
  endif()
  execute_process(COMMAND "${BENCHMARK}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE csv ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "CSV benchmark failed: ${error}")
  endif()
  string(REPLACE "\n" ";" lines "${csv}")
  list(POP_FRONT lines header)
  if(NOT header STREQUAL "Instruction,Wave,Semantics,Instruction flags,FP state,CPU path,ns/wave,Speedup")
    message(FATAL_ERROR "Invalid CSV header: ${header}")
  endif()
  set(csv_rows)
  foreach(line IN LISTS lines)
    if(line STREQUAL "")
      continue()
    endif()
    if(NOT line MATCHES "^([vs]_[a-z0-9_]+,(32|64),(loose|exact),[^,]+,(none|flush-input|fp16-ovfl|flush-io-ovfl),[^,]+),[0-9]+\\.[0-9],([0-9]+\\.[0-9][0-9])?$")
      message(FATAL_ERROR "Invalid CSV row or stdout contamination: ${line}")
    endif()
    list(APPEND csv_rows "${CMAKE_MATCH_1}")
  endforeach()
  if(NOT csv_rows STREQUAL table_rows)
    message(FATAL_ERROR "CSV and table workloads differ")
  endif()
endforeach()

foreach(arguments IN ITEMS "--csv;--csv" "--csv;0" "--csv;-1" "--csv;garbage" "1;2" "--unknown"
    "--min-ms" "--min-ms;-1" "--min-ms;no" "--min-ms;1.5"
    "--min-ms;2147483648" "--min-ms;--csv" "--min-ms;0;--min-ms;0")
  execute_process(COMMAND "${BENCHMARK}" ${arguments}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT status EQUAL 2 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Invalid arguments were not rejected cleanly: ${arguments}")
  endif()
endforeach()
